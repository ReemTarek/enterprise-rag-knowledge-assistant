{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Ai": {
    "Provider": "Ollama",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "qwen3:8b",
      "EmbeddingModel": "nomic-embed-text",
      "EmbeddingDimensions": 768,
      "TimeoutSeconds": 180
    }
  },
  "Rag": {
    "ChunkSize": 700,
    "ChunkOverlap": 100,
    "TopK": 5
  }
}
